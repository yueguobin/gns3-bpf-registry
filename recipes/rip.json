    {"layer": "IP", "fields": {"src": "$IP_SRC", "dst": "$IP_DST", "chksum": "$PIN"}},
    {"layer": "UDP", "fields": {"sport": 12345, "dport": 520, "chksum": "$PIN"}},
    {"layer": "RIP", "fields": {"cmd": 2, "version": 2, "null": 0}}
